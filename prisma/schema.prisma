// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
}

model Account {
  id                Int           @id @default(autoincrement())
  email             String
  user              User?

  @@map("account")
}

model User {
  id                  Int           @id @default(autoincrement())
  username            String
  account             Account       @relation(fields: [accountId], references: id, onDelete: Cascade)
  accountId           Int           @unique @map("account_id")
  createdAlbums       Album[]
  collectedAlbums     UserAlbumCollection[]
  collectedStickers   UserStickerCollection[] 

  @@map("user")
}

model Album {
  id                Int           @id @default(autoincrement())
  name              String
  pages             AlbumPage[]
  status            Status
  coverImgUrl       String?       @map("cover_img_url")
  backCoverImgUrl   String?       @map("back_cover_img_url")
  authorId          Int           @map("author_id")
  description       String?
  author            User          @relation(fields: [authorId], references: id)
  collectedByUsers  UserAlbumCollection[]

  @@map("album")
}

model UserAlbumCollection {
  user        User      @relation(fields: [userId], references: [id])
  userId      Int       @map("user_id")
  album       Album     @relation(fields: [albumId], references: [id])
  albumId     Int       @map("album_id")

  @@id([albumId, userId])
  @@map("user_album_collection")
}

model AlbumPageTemplate {
  id                Int          @id @default(autoincrement())
  stickerQty        Int          @map("sticker_qty")
  albumPages        AlbumPage[]

  @@map("album_page_template")
}

model AlbumPage {
  id                  Int                 @id @default(autoincrement())
  albumId             Int                 @map("album_id")
  album               Album               @relation(fields: [albumId], references: [id], onDelete: Cascade) 
  stickers            Sticker[]
  pageNumber          Int                 @map("page_number")
  name                String?
  templateId          Int                 @map("template_id")
  template            AlbumPageTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([albumId, pageNumber])
  @@map("album_page")
}

model Sticker {
  id                Int                       @id @default(autoincrement())
  name              String
  albumPageId       Int                       @map("album_page_id")
  albumPage         AlbumPage                 @relation(fields: [albumPageId], references: [id], onDelete: Cascade) 
  stickerNumber     Int                       @map("sticker_number")
  status            Status
  imgUrl            String?                   @map("img_url")
  description       String?
  collectedByUsers  UserStickerCollection[]

  @@map("sticker")
}

model UserStickerCollection {
  userId        Int       @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerId     Int       @map("sticker_id")
  sticker       Sticker   @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  isGlued       Boolean   @default(false) @map("is_glued")

  @@id([userId, stickerId])
  @@map("user_sticker_collection")
}
