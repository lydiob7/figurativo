// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  DRAFT
  PUBLISHED
}

model Album {
  id                Int           @id @default(autoincrement())
  name              String
  pages             AlbumPage[]
  status            Status
  coverImgUrl       String?
  backCoverImgUrl   String?
}

model AlbumPage {
  id                  Int           @id @default(autoincrement())
  albumId             Int
  album               Album         @relation(fields: [albumId], references: [id], onDelete: Cascade) 
  stickers            Sticker[]
  pageNumber          Int
  name                String?
  firstStickerNumber  Int
  lastStickerNumber   Int

  @@unique([albumId, pageNumber])
}

model Sticker {
  id                Int           @id @default(autoincrement())
  name              String
  albumPageId       Int
  albumPage         AlbumPage     @relation(fields: [albumPageId], references: [id], onDelete: Cascade) 
  stickerNumber     Int
  status            Status
  imgUrl            String?
  description       String?
}